#!/bin/sh
set -eu
native="$HOME/.codex/packages/standalone/current/bin/codex"
if [ -z "${AGENT_LB_API_KEY:-}" ] && [ -f "$HOME/.config/agent-lb/env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line#${line%%[![:space:]]*}}
        case "$line" in
            export\ AGENT_LB_API_KEY=*) value=${line#export AGENT_LB_API_KEY=} ;;
            AGENT_LB_API_KEY=*) value=${line#AGENT_LB_API_KEY=} ;;
            *) continue ;;
        esac
        if [ "${#value}" -ge 2 ]; then
            first=${value%"${value#?}"}; last=${value#?}; last=${last#"${last%?}"}
            if { [ "$first" = '"' ] && [ "$last" = '"' ]; } || { [ "$first" = "'" ] && [ "$last" = "'" ]; }; then value=${value#?}; value=${value%?}; fi
        fi
        [ -n "$value" ] || continue
        AGENT_LB_API_KEY=$value; break
    done < "$HOME/.config/agent-lb/env"
fi
if [ -z "${AGENT_LB_API_KEY:-}" ]; then
    echo "codex-agent-lb: AGENT_LB_API_KEY is not set and was not found in $HOME/.config/agent-lb/env" >&2
    exit 78
fi
export AGENT_LB_API_KEY
exec "$native" "$@"
